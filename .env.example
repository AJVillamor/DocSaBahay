# Used by docker-compose.yml. Copy to .env and change the secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Set to true when the site is served over HTTPS (adds Secure to auth cookies).
COOKIE_SECURE=false

# Fictional seed admin (created only by the seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
