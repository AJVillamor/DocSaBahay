# Copy to apps/web/.env for local development (`pnpm dev`).
# Target of the /api/* rewrite. Read when Next.js starts or builds.
API_URL=http://localhost:4000
# Where the browser opens its notifications WebSocket connection directly (not
# proxied through /api/*, since the socket authenticates with a short-lived
# token rather than the httpOnly cookies the /api/* rewrite exists to carry).
# Baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
