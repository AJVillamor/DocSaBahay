# Copy to apps/api/.env for local development (`pnpm dev`).
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doksabahay?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/doksabahay_test?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Fictional seed admin (created only by the seed script)
ADMIN_EMAIL=admin@doksabahay.test
ADMIN_PASSWORD=ChangeMe123!
